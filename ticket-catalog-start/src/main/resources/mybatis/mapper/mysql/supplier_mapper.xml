<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.owen.infrastructure.dao.ISupplierDao">

    <resultMap id="dataMap" type="com.owen.infrastructure.dao.po.Supplier">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="columns">
        id, name, create_time, update_time
    </sql>

    <insert id="insert" parameterType="com.owen.infrastructure.dao.po.Supplier" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO supplier (name, create_time, update_time)
        VALUES (#{name}, now(), now())
    </insert>

    <update id="update" parameterType="com.owen.infrastructure.dao.po.Supplier">
        UPDATE supplier
        SET name = #{name},
            update_time = now()
        WHERE id = #{id}
    </update>

    <select id="selectById" parameterType="java.lang.Long" resultMap="dataMap">
        SELECT <include refid="columns"/>
        FROM supplier
        WHERE id = #{id}
    </select>

    <select id="selectByName" parameterType="java.lang.String" resultMap="dataMap">
        SELECT <include refid="columns"/>
        FROM supplier
        WHERE name = #{name}
    </select>

    <select id="selectAll" resultMap="dataMap">
        SELECT <include refid="columns"/>
        FROM supplier
    </select>

</mapper>
